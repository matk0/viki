#!/command/with-contenv sh
set -eu

export HOME=/opt/data
export HERMES_HOME=/opt/data/profiles/viki-edit
export HERMES_DASHBOARD_SESSION_TOKEN="${HERMES_EDIT_TOKEN:-viki-local-edit-session}"
export HERMES_TUI_TOOLSETS=memory,clarify,viki_read,viki_edit
export HERMES_TUI_PASS_SESSION_ID=0
export VIKI_HERMES_TOOL_TOKEN="${VIKI_HERMES_TOOL_TOKEN:-viki-local-tool-service}"
export VIKI_INTERNAL_URL="${VIKI_INTERNAL_URL:-http://127.0.0.1:8090}"

cd /opt/data
/command/s6-setuidgid hermes python3 /opt/viki-hermes/verify_runtime.py edit
exec s6-setuidgid hermes hermes -p viki-edit serve --isolated --host 127.0.0.1 --port 9120 --no-open
