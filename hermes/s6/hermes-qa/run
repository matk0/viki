#!/command/with-contenv sh
set -eu

export HOME=/opt/data
export HERMES_HOME=/opt/data/profiles/viki-qa
: "${HERMES_QA_TOKEN:?HERMES_QA_TOKEN is required}"
: "${VIKI_HERMES_TOOL_TOKEN:?VIKI_HERMES_TOOL_TOKEN is required}"
export HERMES_DASHBOARD_SESSION_TOKEN="$HERMES_QA_TOKEN"
export HERMES_TUI_TOOLSETS=memory,clarify,viki_read
export HERMES_TUI_PASS_SESSION_ID=0
export VIKI_HERMES_TOOL_TOKEN
export VIKI_INTERNAL_URL="${VIKI_INTERNAL_URL:-http://viki:8090}"

cd /opt/data
/command/s6-setuidgid hermes python3 /opt/viki-hermes/verify_runtime.py qa
exec s6-setuidgid hermes hermes -p viki-qa serve --isolated --host 127.0.0.1 --port 9119 --no-open
