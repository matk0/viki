#!/command/with-contenv sh
set -eu

export HOME=/opt/data
export HERMES_HOME=/opt/data/profiles/viki-developer
export HERMES_TUI_TOOLSETS=viki_develop
export HERMES_TUI_PASS_SESSION_ID=0
export VIKI_HERMES_TOOL_TOKEN="${VIKI_HERMES_TOOL_TOKEN:-viki-local-tool-service}"
export VIKI_INTERNAL_URL="${VIKI_INTERNAL_URL:-http://viki:8090}"

cd /opt/data
exec s6-setuidgid hermes hermes -p viki-developer gateway run --no-supervise --external-supervisor
