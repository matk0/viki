# Fine-grained PAT: resource owner matk0, only matk0/vozokany.
# Actions: read; Contents: read; Metadata: read. No write permissions.
# Create a new dedicated credential; do not copy a broad CLI/admin token.
VIKI_GITHUB_READ_TOKEN=

# The tracked Vozokany Compose file sets the workflow and legacy artifact prefix.
# For a generic worker deployment, configure these explicitly if different:
# VIKI_GIT_WORKFLOW=.github/workflows/verify.yml
# VIKI_GIT_ARTIFACT_PREFIX=gherkin-specs-v2
